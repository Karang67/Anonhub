# AnonHub Production Environment Template
PORT=3000
NODE_ENV=production

# Database Configuration (replace with your MongoDB connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/anonhub-db
# Legacy env name supported: `MONGO_URI` (if your host or CI sets that instead).
# Note: the server prefers `MONGODB_URI`. If both are set, `MONGODB_URI` takes precedence over `MONGO_URI`.
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/anonhub-db

# CORS Configuration (comma-separated list of allowed origins)
# In production set to your deployed frontend origin(s). Example:
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Optional: Google Gemini API Key for AI Assistant (falls back to Mock mode if empty)
GEMINI_API_KEY=

# SMTP / Email settings (optional - used for feedback emails)
# For SMTP use:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional: Maximum upload size (defaults to 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
