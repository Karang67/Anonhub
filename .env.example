# AnonHub Backend Environment Template (Render)
PORT=10000
NODE_ENV=production

# Database Configuration (replace with your MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/anonhub-db
# Legacy env name supported: `MONGO_URI`
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/anonhub-db

# Frontend Domain & CORS Configuration (Vercel domain)
FRONTEND_URL=https://your-app-name.vercel.app
# Comma-separated list of allowed origins (production whitelist):
ALLOWED_ORIGINS=https://your-app-name.vercel.app,http://localhost:5173

# Optional: Google Gemini API Key for AI Assistant (falls back to Mock mode if empty)
GEMINI_API_KEY=

# Admin Authentication Key & Password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
ADMIN_PAGE_KEY=anonhub-admin-key

# SMTP / Email settings (optional - used for feedback emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Web3Forms API Key for receiving feedback emails (Get free key at https://web3forms.com)
WEB3FORMS_ACCESS_KEY=

# Optional: Maximum upload size (defaults to 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760
