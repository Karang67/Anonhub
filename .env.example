# Trinetra / AnonHub - Environment Template
# Copy this to .env and fill in ALL values before deploying.
# NEVER commit .env to version control.

# Server
NODE_ENV=production
PORT=10000

# MongoDB (use Atlas in production, NOT localhost)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# CORS - comma-separated allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Admin Credentials - MUST change from defaults (server exits in prod if defaults detected)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-password-here
ADMIN_PAGE_KEY=your-unique-admin-page-key
ADMIN_SESSION_SECRET=your-long-random-session-secret-32chars-minimum
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_SESSION_MAX_AGE=604800000

# Google Gemini AI - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_VERSION=v1

# Email SMTP (Gmail App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# Web3Forms (alternative to SMTP - https://web3forms.com)
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Rate Limits (tune for your traffic)
RL_WINDOW_MS=60000
RL_API_MAX=100
RL_AUTH_MAX=10
RL_ROOM_CREATE=5
RL_ROOM_JOIN=20
RL_COMPILE_MAX=10
RL_AI_MAX=20
RL_UPLOAD_MAX=10

# File Upload
MAX_FILE_SIZE_MB=10

# Code Execution
CODE_EXECUTION_TIMEOUT_MS=5000
CODE_MEMORY_LIMIT_MB=128
CODE_MAX_OUTPUT_KB=512

# Room Lifecycle
ROOM_INACTIVITY_DAYS=15
ROOM_DELETE_GRACE_DAYS=2
